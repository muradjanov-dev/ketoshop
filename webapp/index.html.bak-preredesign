// ===== SYSTEM BACK BUTTON =====
// Telegram exposes tg.BackButton (Android hardware back, iOS swipe-back, and
// the in-app back arrow). Without this hooked up, system-back closes the
// whole Mini App — pressing it after opening a product detail dropped the
// buyer all the way out instead of just closing the modal.
function _isModalOpen(id) {
  const el = document.getElementById(id);
  return el && el.classList.contains('show');
}

function onBackPressed() {
  // Highest-priority overlays win.
  if (_isModalOpen('map-modal')) { closeMapPicker(); return; }
  if (_isModalOpen('detail-modal')) { closeDetail(); return; }
  // Then page-level: anywhere except home → go home. (Home itself has
  // BackButton hidden, so Telegram handles back natively → app closes.)
  if (activePage && activePage !== 'home') {
    switchPage('home');
  }
}

function updateBackButton() {
  if (!tg.BackButton) return;
  const shouldShow = (
    _isModalOpen('map-modal') ||
    _isModalOpen('detail-modal') ||
    (activePage && activePage !== 'home')
  );
  if (shouldShow) tg.BackButton.show();
  else tg.BackButton.hide();
}

if (tg.BackButton) {
  tg.BackButton.onClick(onBackPressed);
}

document.querySelectorAll('.tab-item').forEach(tab => {
  tab.addEventListener('click', () => switchPage(tab.dataset.page));
});

// ===== INIT =====
(async function init() {
  // Fetch user's saved language from API
  try {
    const langData = await api('/api/lang');
    if (langData.lang && L[langData.lang]) {
      lang = langData.lang;
      t = L[lang];
      localStorage.setItem('ketoshop_lang', lang);
    }
  } catch(e) { /* use fallback */ }

  applyLanguage();
  updateBackButton();

  try {
    categories = await api('/api/categories');
    renderHomePage();
    renderCatalogCategories();
    await loadProducts();
    await loadCart();
  } catch(e) {
    console.error('Init error:', e);
    showToast(t.errorLoad, true);
  }
})();

// ===== HOME PAGE =====
async function renderHomePage() {
  const container = document.getElementById('home-sections');
  const loading = document.getElementById('home-loading');
  container.innerHTML = '';
  loading.style.display = 'block';
  loading.textContent = t.loading;

  try {
    // Load each category's products in parallel
    const promises = categories.map(cat =>
      api('/api/products?category=' + cat.key + '&page=0')
        .then(data => ({ cat, products: data.products || [], total: data.total || 0 }))
        .catch(() => ({ cat, products: [], total: 0 }))
    );
    const [topProducts, results] = await Promise.all([
      api('/api/top').catch(() => []),
      Promise.all(promises),
    ]);

    loading.style.display = 'none';

    // Top-3 most-ordered products — podium at the very top of the home page.
    if (Array.isArray(topProducts) && topProducts.length) {
      container.appendChild(buildPodium(topProducts));
    }

    results.forEach(({ cat, products, total }) => {
      if (products.length === 0) return;
      homeProductsCache[cat.key] = products;

      const section = document.createElement('div');
      section.className = 'home-section';

      // Section header
      const header = document.createElement('div');
      header.className = 'section-header';

      const title = document.createElement('div');
      title.className = 'section-title';
      title.textContent = cat.name;

      const moreBtn = document.createElement('button');
      moreBtn.className = 'section-more';
      moreBtn.innerHTML = total > 0
        ? t.moreN.replace('{n}', total) + ' &#x203A;'
        : '&#x203A;';
      moreBtn.onclick = () => openCatalogCategory(cat.key);

      header.appendChild(title);
      header.appendChild(moreBtn);
      section.appendChild(header);

      // Carousel
      const carousel = document.createElement('div');
      carousel.className = 'carousel';
      products.slice(0, 8).forEach(p => {
        carousel.appendChild(createCarouselCard(p));
      });
      section.appendChild(carousel);
      container.appendChild(section);
    });

    if (container.children.length === 0) {
      container.innerHTML = '<div class="empty-state"><div class="emoji">📦</div><div>' + t.empty + '</div></div>';
    }
  } catch(e) {
    loading.style.display = 'none';
    console.error('Home load error:', e);
    showToast(t.errorLoad, true);
  }
}

function buildPodium(top) {
  // `top` is in rank order: [1st, 2nd, 3rd]. Lay out as a classic podium —
  // 2nd on the left, 1st (raised) in the center, 3rd on the right.
  const medals = ['🥇', '🥈', '🥉'];
  const section = document.createElement('div');
  section.className = 'home-section podium-section';

  const header = document.createElement('div');
  header.className = 'section-header';
  const title = document.createElement('div');
  title.className = 'section-title';
  title.textContent = '🏆 ' + (lang === 'ru' ? 'Хиты продаж' : 'Eng ko‘p sotilganlar');
  header.appendChild(title);
  section.appendChild(header);

  const podium = document.createElement('div');
  podium.className = 'podium';
  [1, 0, 2].forEach(rankIdx => {
    const p = top[rankIdx];
    if (!p) return;
    const item = document.createElement('div');
    item.className = 'podium-item rank-' + (rankIdx + 1);
    item.onclick = () => openDetail(p.id);
    const img = p.photo_url
      ? '<img class="podium-img" src="' + p.photo_url + '" alt="" loading="lazy" onerror="this.outerHTML=\'<div class=podium-nophoto>📦</div>\'">'
      : '<div class="podium-nophoto">📦</div>';
    item.innerHTML =
      '<div class="podium-medal">' + medals[rankIdx] + '</div>' +
      img +
      '<div class="podium-name">' + escapeHtml(p.name) + '</div>' +
      '<div class="podium-price">' + priceHtml(p) + '</div>';
    podium.appendChild(item);
  });
  section.appendChild(podium);
  return section;
}

function createCarouselCard(p) {
  const card = document.createElement('div');
  card.className = 'carousel-card';
  card.onclick = () => openDetail(p.id);

  const isFav = !!favorites[p.id];
  let imgInner;
  if (p.photo_url) {
    imgInner = '<img class="card-img" src="' + p.photo_url + '" alt="" loading="lazy" onerror="this.outerHTML=\'<div class=no-photo>📦</div>\'">';
  } else {
    imgInner = '<div class="no-photo">📦</div>';
  }

  const descHtml = p.description ? '<div class="card-desc">' + escapeHtml(p.description) + '</div>' : '';
  card.innerHTML =
    '<div class="card-img-wrap">' +
      discountCornerHtml(p) +
      discountUntilCornerHtml(p) +
      imgInner +
      '<button class="card-fav-btn" data-id="' + p.id + '">' + (isFav ? '❤️' : '🤍') + '</button>' +
    '</div>' +
    '<div class="card-price">' + priceHtml(p) + '</div>' +
    savingHtml(p) +
    '<div class="card-name">' + escapeHtml(p.name) + '</div>' +
    descHtml;

  // Fav button click (stop propagation so card click doesn't fire)
  card.querySelector('.card-fav-btn').onclick = (e) => {
    e.stopPropagation();
    toggleFav(p);
    e.currentTarget.textContent = favorites[p.id] ? '❤️' : '🤍';
  };

  return card;
}

function openCatalogCategory(catKey) {
  switchPage('catalog');
  selectCategory(catKey);
}

// ===== CATALOG PAGE =====
function renderCatalogCategories() {
  const container = document.getElementById('categories');
  container.innerHTML = '';

  // "All" tab
  const allTab = document.createElement('button');
  allTab.className = 'cat-tab active';
  allTab.dataset.cat = 'all';
  allTab.textContent = t.all;
  allTab.onclick = () => selectCategory('all');
  container.appendChild(allTab);

  // Discounts pseudo-category — only products currently on discount.
  const discTab = document.createElement('button');
  discTab.className = 'cat-tab';
  discTab.dataset.cat = 'discounts';
  discTab.textContent = t.discountsTab;
  discTab.onclick = () => selectCategory('discounts');
  container.appendChild(discTab);

  categories.forEach(cat => {
    const tab = document.createElement('button');
    tab.className = 'cat-tab';
    tab.dataset.cat = cat.key;
    tab.textContent = cat.name;
    tab.onclick = () => selectCategory(cat.key);
    container.appendChild(tab);
  });
}

function selectCategory(key) {
  currentCat = key;
  currentPage = 0;
  document.querySelectorAll('#categories .cat-tab').forEach(el => {
    el.classList.toggle('active', el.dataset.cat === key);
  });
  // Scroll active tab into view
  const activeTab = document.querySelector('#categories .cat-tab.active');
  if (activeTab) activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  document.getElementById('catalog-search').value = '';
  loadProducts();
}

let isLoadingMore = false;

async function loadProducts(append = false) {
  const grid = document.getElementById('product-grid');
  const loading = document.getElementById('catalog-loading');
  const empty = document.getElementById('catalog-empty');
  const scrollLoader = document.getElementById('scroll-loader');

  if (!append) {
    grid.innerHTML = '';
    loading.style.display = 'block';
    loading.textContent = t.loading;
    empty.style.display = 'none';
  }
  scrollLoader.style.display = 'none';
  isLoadingMore = true;

  try {
    let products;
    if (currentCat === 'all') {
      const data = await api('/api/products?page=' + currentPage);
      products = Array.isArray(data) ? data : (data.products || []);
      totalPages = data.pages || 1;
    } else {
      const data = await api('/api/products?category=' + currentCat + '&page=' + currentPage);
      products = data.products || [];
      totalPages = data.pages || 1;
    }

    loading.style.display = 'none';

    if (!append && products.length === 0) {
      empty.style.display = 'block';
      document.getElementById('catalog-empty-text').textContent = t.empty;
      isLoadingMore = false;
      return;
    }

    products.forEach(p => {
      grid.appendChild(createProductCard(p));
    });

    isLoadingMore = false;
  } catch(e) {
    loading.style.display = 'none';
    isLoadingMore = false;
    console.error('Load products error:', e);
    showToast(t.errorLoad, true);
  }
}

// Infinite scroll
window.addEventListener('scroll', () => {
  if (activePage !== 'catalog' || isLoadingMore) return;
  if (currentPage + 1 >= totalPages) return;

  const scrollY = window.scrollY + window.innerHeight;
  const docHeight = document.documentElement.scrollHeight;

  if (scrollY >= docHeight - 300) {
    currentPage++;
    isLoadingMore = true;
    document.getElementById('scroll-loader').style.display = 'block';
    loadProducts(true);
  }
});

function createProductCard(p) {
  const card = document.createElement('div');
  card.className = 'product-card';
  card.onclick = () => openDetail(p.id);

  const isFav = !!favorites[p.id];
  let imgInner;
  if (p.photo_url) {
    imgInner = '<img src="' + p.photo_url + '" alt="" loading="lazy" onerror="this.outerHTML=\'<div class=no-photo>📦</div>\'">';
  } else {
    imgInner = '<div class="no-photo">📦</div>';
  }

  const descHtml2 = p.description ? '<div class="card-desc">' + escapeHtml(p.description) + '</div>' : '';
  const soonBadge = p.out_of_stock ? '<div class="card-desc" style="color:#c33;font-weight:600">' + (t.comingSoon || '⏳') + '</div>' : '';
  card.innerHTML =
    '<div class="card-img-wrap"' + (p.out_of_stock ? ' style="opacity:0.55"' : '') + '>' +
      discountCornerHtml(p) +
      discountUntilCornerHtml(p) +
      imgInner +
      '<button class="card-fav-btn" data-id="' + p.id + '">' + (isFav ? '❤️' : '🤍') + '</button>' +
    '</div>' +
    '<div class="card-price">' + priceHtml(p) + '</div>' +
    savingHtml(p) +
    '<div class="card-name">' + escapeHtml(p.name) + '</div>' +
    descHtml2 +
    soonBadge;

  card.querySelector('.card-fav-btn').onclick = (e) => {
    e.stopPropagation();
    toggleFav(p);
    e.currentTarget.textContent = favorites[p.id] ? '❤️' : '🤍';
  };

  return card;
}

// Catalog search
document.getElementById('catalog-search').addEventListener('input', function(e) {
  clearTimeout(searchTimeout);
  const q = e.target.value.trim();
  if (q.length < 2) {
    if (q.length === 0) loadProducts();
    return;
  }
  searchTimeout = setTimeout(async () => {
    const grid = document.getElementById('product-grid');
    const loading = document.getElementById('catalog-loading');
    const empty = document.getElementById('catalog-empty');
    document.getElementById('scroll-loader').style.display = 'none';
    grid.innerHTML = '';
    loading.style.display = 'block';
    loading.textContent = t.loading;
    empty.style.display = 'none';

    document.querySelectorAll('#categories .cat-tab').forEach(el => el.classList.remove('active'));

    try {
      const products = await api('/api/search?q=' + encodeURIComponent(q));
      loading.style.display = 'none';
      if (products.length === 0) {
        empty.style.display = 'block';
        document.getElementById('catalog-empty-text').textContent = t.empty;
        return;
      }
      products.forEach(p => grid.appendChild(createProductCard(p)));
    } catch(e) {
      loading.style.display = 'none';
      console.error('Search error:', e);
      if (e && e.status === 403) {
        showToast(t.errorSessionExpired, true);
      } else {
        showToast(t.errorLoad, true);
      }
    }
  }, 400);
});

// ===== PRODUCT DETAIL =====
async function openDetail(productId) {
  try {
    const p = await api('/api/product/' + productId);
    currentProduct = p;
    qty = 1;

    document.getElementById('detail-name').textContent = p.name;
    document.getElementById('detail-price').innerHTML = priceHtml(p);

    const savingEl = document.getElementById('detail-saving');
    const dPct = p.discount_percent || 0;
    if (dPct > 0 && p.original_price && p.original_price > p.price) {
      const saved = Math.round(p.original_price - p.price);
      savingEl.textContent = '🔥 −' + dPct + '% · ' + t.youSave.replace('{amount}', formatPrice(saved));
      savingEl.style.display = 'block';
    } else {
      savingEl.style.display = 'none';
      savingEl.textContent = '';
    }

    const untilEl = document.getElementById('detail-discount-until');
    if (p.discount_percent && p.discount_until) {
      untilEl.textContent = t.discountUntil.replace('{date}', formatDiscountDate(p.discount_until));
    } else {
      untilEl.textContent = '';
    }
    document.getElementById('detail-unit').textContent = t.perUnit.replace('{unit}', p.unit);
    const descEl = document.getElementById('detail-desc');
    if (p.description) {
      descEl.innerHTML = escapeHtml(p.description).replace(/\n/g, '<br>');
    } else {
      descEl.textContent = '';
    }
    document.getElementById('qty-value').textContent = qty;
    const addBtn = document.getElementById('add-to-cart-btn');
    if (p.out_of_stock) {
      addBtn.textContent = t.comingSoon;
      addBtn.disabled = true;
      addBtn.style.opacity = '0.55';
    } else {
      addBtn.textContent = t.addToCart;
      addBtn.disabled = false;
      addBtn.style.opacity = '';
    }

    // Favorite button
    document.getElementById('detail-fav-btn').textContent = favorites[p.id] ? '❤️' : '🤍';

    // Photo + extra media carousel
    const photoContainer = document.getElementById('detail-photo-container');
    const allMedia = [];
    if (p.photo_url) {
      allMedia.push({ url: p.photo_url, type: 'photo' });
    }
    if (p.media && p.media.length > 0) {
      p.media.forEach(m => allMedia.push(m));
    }

    if (allMedia.length === 0) {
      photoContainer.innerHTML = '<div class="no-photo" style="aspect-ratio:1;border-radius:0">📦</div>';
    } else if (allMedia.length === 1) {
      const m = allMedia[0];
      if (m.type === 'video') {
        photoContainer.innerHTML = '<video class="detail-video" src="' + m.url + '" controls playsinline></video>';
      } else {
        photoContainer.innerHTML = '<img class="detail-img" src="' + m.url + '" alt="" onerror="this.style.display=\'none\'">';
      }
    } else {
      let slidesHtml = '';
      let dotsHtml = '';
      allMedia.forEach((m, i) => {
        if (m.type === 'video') {
          slidesHtml += '<div class="media-slide"><video src="' + m.url + '" controls playsinline></video></div>';
        } else {
          slidesHtml += '<div class="media-slide"><img src="' + m.url + '" alt="" onerror="this.parentElement.style.display=\'none\'"></div>';
        }
        dotsHtml += '<div class="dot' + (i === 0 ? ' active' : '') + '"></div>';
      });
      photoContainer.innerHTML =
        '<div class="detail-media-carousel" id="media-carousel">' + slidesHtml + '</div>' +
        '<div class="media-dots" id="media-dots">' + dotsHtml + '</div>';

      // Dot indicator on scroll
      const carousel = document.getElementById('media-carousel');
      const dots = document.querySelectorAll('#media-dots .dot');
      carousel.addEventListener('scroll', () => {
        const idx = Math.round(carousel.scrollLeft / carousel.clientWidth);
        dots.forEach((d, i) => d.classList.toggle('active', i === idx));
      });
    }

    // Rating
    const ratingEl = document.getElementById('detail-rating');
    if (p.review_count > 0) {
      ratingEl.textContent = '⭐ ' + t.rating.replace('{rating}', p.rating).replace('{count}', p.review_count);
    } else {
      ratingEl.textContent = '';
    }

    // Seller
    const sellerEl = document.getElementById('detail-seller');
    if (p.seller_name) {
      sellerEl.textContent = t.seller.replace('{name}', p.seller_name);
    } else {
      sellerEl.textContent = '';
    }

    document.getElementById('detail-modal').classList.add('show');
    updateBackButton();
  } catch(e) {
    console.error('Detail error:', e);
    showToast(t.errorLoad, true);
  }
}

function closeDetail() {
  document.getElementById('detail-modal').classList.remove('show');
  currentProduct = null;
  updateBackButton();
}

function changeQty(delta) {
  // Whole-number quantities only — buyers were ending up with 0.5 / 1.5
  // entries because the old logic let non-kg units step in halves. Now
  // every product steps by 1 with a minimum of 1, regardless of unit.
  // currentProduct.packaged is still returned by the server but no longer
  // influences stepping.
  const stock = (currentProduct && typeof currentProduct.quantity === 'number') ? currentProduct.quantity : 50;
  const max = Math.max(1, Math.min(stock, 50));
  qty = Math.max(1, Math.min(Math.round(qty + delta), max));
  document.getElementById('qty-value').textContent = qty;
}

// ===== FAVORITES =====
function toggleFavFromDetail() {
  if (!currentProduct) return;
  toggleFav(currentProduct);
  document.getElementById('detail-fav-btn').textContent = favorites[currentProduct.id] ? '❤️' : '🤍';
}

function toggleFav(product) {
  if (favorites[product.id]) {
    delete favorites[product.id];
  } else {
    favorites[product.id] = {
      id: product.id,
      name: product.name,
      price: product.price,
      original_price: product.original_price || product.price,
      discount_percent: product.discount_percent || 0,
      unit: product.unit,
      photo_url: product.photo_url || ''
    };
  }
  try {
    localStorage.setItem('ketoshop_fav', JSON.stringify(favorites));
  } catch (e) {
    console.warn('Favorites storage failed:', e);
    showToast(t.errorFavStorage || 'Sevimlilarni saqlab bo\'lmadi', true);
  }
}

function renderFavPage() {
  const grid = document.getElementById('fav-grid');
  const empty = document.getElementById('fav-empty');
  grid.innerHTML = '';

  const items = Object.values(favorites);
  if (items.length === 0) {
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  items.forEach(p => {
    grid.appendChild(createProductCard(p));
  });
}

// ===== CART =====
async function addToCart() {
  if (!currentProduct) return;
  const btn = document.getElementById('add-to-cart-btn');
  try {
    if (btn) btn.disabled = true;
    await api('/api/cart/add', {
      method: 'POST',
      body: JSON.stringify({ product_id: currentProduct.id, quantity: qty })
    });
    closeDetail();
    await loadCart();
    if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred('light');
    showToast(t.addedToCart);
  } catch(e) {
    console.error('Add to cart error:', e);
    showToast(t.errorCart, true);
  } finally {
    if (btn) btn.disabled = false;
  }
}

async function loadCart() {
  try {
    cartData = await api('/api/cart');
    updateCartBadge();
    // If cart page is active, refresh it
    if (activePage === 'cart') renderCartPage();
  } catch(e) {
    console.error('Load cart error:', e);
  }
}

function updateCartBadge() {
  const badge = document.getElementById('cart-badge');
  const count = cartData.items.reduce((sum, i) => sum + i.quantity, 0);
  if (count > 0) {
    badge.classList.add('visible');
    badge.textContent = count % 1 === 0 ? count : count.toFixed(1);
  } else {
    badge.classList.remove('visible');
  }
}

function renderCartPage() {
  const container = document.getElementById('cart-items');
  const emptyEl = document.getElementById('cart-empty');
  const footer = document.getElementById('cart-footer');
  container.innerHTML = '';

  if (cartData.items.length === 0) {
    emptyEl.style.display = 'block';
    footer.style.display = 'none';
    return;
  }

  emptyEl.style.display = 'none';
  footer.style.display = 'block';

  cartData.items.forEach(item => {
    const el = document.createElement('div');
    el.className = 'cart-item';

    let photoHtml;
    if (item.photo_url) {
      photoHtml = '<img src="' + item.photo_url + '" alt="" onerror="this.outerHTML=\'<div class=no-photo-sm>📦</div>\'">';
    } else {
      photoHtml = '<div class="no-photo-sm">📦</div>';
    }

    const qtyDisplay = item.quantity % 1 === 0 ? item.quantity : item.quantity.toFixed(1);

    const d = item.discount_percent || 0;
    let priceMeta;
    if (d > 0 && item.original_price && item.original_price !== item.price) {
      priceMeta = qtyDisplay + ' ' + item.unit + ' &times; ' +
                  '<span class="price-old">' + formatPrice(item.original_price) + '</span>' +
                  '<span class="price-new">' + formatPrice(item.price) + '</span>' +
                  '<span class="discount-badge">-' + d + '%</span>';
      // Total saved on this line (per-unit saving × quantity).
      const savedLine = Math.round((item.original_price - item.price) * item.quantity);
      if (savedLine > 0) {
        priceMeta += '<div class="item-saving">' + t.youSave.replace('{amount}', formatPrice(savedLine)) + '</div>';
      }
    } else {
      priceMeta = qtyDisplay + ' ' + item.unit + ' &times; ' + formatPrice(item.price);
    }

    const stepper =
      '<div class="qty-stepper">' +
        '<button class="qty-step" data-action="dec" data-id="' + item.cart_id + '" aria-label="-">&minus;</button>' +
        '<span class="qty-step-value">' + qtyDisplay + '</span>' +
        '<button class="qty-step" data-action="inc" data-id="' + item.cart_id + '" aria-label="+">+</button>' +
      '</div>';

    el.innerHTML = photoHtml +
      '<div class="item-info">' +
        '<div class="item-name">' + escapeHtml(item.name) + '</div>' +
        '<div class="item-meta">' + priceMeta + '</div>' +
        stepper +
      '</div>' +
      '<div class="item-price">' + formatPrice(item.total) + '</div>' +
      '<button class="remove-btn" data-id="' + item.cart_id + '">&times;</button>';
    container.appendChild(el);
  });

  // Remove buttons
  container.querySelectorAll('.remove-btn').forEach(btn => {
    btn.onclick = async (e) => {
      e.stopPropagation();
      try {
        btn.disabled = true;
        await api('/api/cart/remove', {
          method: 'POST',
          body: JSON.stringify({ cart_id: parseInt(btn.dataset.id) })
        });
        await loadCart();
      } catch(err) {
        console.error(err);
        btn.disabled = false;
      }
    };
  });

  // Quantity steppers — increment/decrement with stock + step awareness.
  // We disable both buttons during the API roundtrip so a flurry of taps
  // can't outrun the backend and create a stale UI.
  container.querySelectorAll('.qty-step').forEach(btn => {
    btn.onclick = async (e) => {
      e.stopPropagation();
      const cartId = parseInt(btn.dataset.id);
      const item = cartData.items.find(x => x.cart_id === cartId);
      if (!item) return;
      // Always step by 1. Math.round() snaps any pre-existing fractional
      // quantity (left over from before integer-only was enforced) to the
      // nearest whole number so the first tap brings the line back onto
      // a clean integer grid.
      const delta = btn.dataset.action === 'inc' ? 1 : -1;
      let next = Math.round((item.quantity || 0) + delta);
      // Clamp to stock so we don't even bother the server with overshoot.
      if (typeof item.available === 'number' && next > item.available) {
        next = Math.floor(item.available);
      }
      if (next === item.quantity) return;
      const peers = btn.parentElement.querySelectorAll('.qty-step');
      peers.forEach(b => b.disabled = true);
      try {
        await api('/api/cart/update', {
          method: 'POST',
          body: JSON.stringify({ cart_id: cartId, quantity: next })
        });
        await loadCart();
      } catch (err) {
        console.error('Cart update error:', err);
        peers.forEach(b => b.disabled = false);
        showToast(t.errorCart || 'Error', true);
      }
    };
  });

  document.getElementById('cart-total-value').textContent = formatPrice(cartData.total) + ' UZS';

  // Total saved across all discounted lines — a celebratory banner.
  const savedTotal = cartData.items.reduce((s, it) =>
    (it.original_price && it.original_price > it.price)
      ? s + (it.original_price - it.price) * it.quantity
      : s, 0);
  const savedBanner = document.getElementById('cart-saved-banner');
  if (savedTotal > 0) {
    savedBanner.textContent = t.cartSaved.replace('{amount}', formatPrice(Math.round(savedTotal)));
    savedBanner.style.display = 'flex';
  } else {
    savedBanner.style.display = 'none';
  }
}

