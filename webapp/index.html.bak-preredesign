// Centralized "this is the chosen delivery point" — used by both the
// current-location button and the map picker so they stay in sync.
async function setSelectedLocation(lat, lng) {
  document.getElementById('inp-lat').value = lat;
  document.getElementById('inp-lng').value = lng;
  const btn = document.getElementById('btn-get-location');
  const textEl = document.getElementById('location-text');
  textEl.textContent = t.btnLocationSet;
  btn.classList.add('set');
  document.getElementById('location-icon').textContent = '✅';
  renderDeliveryOptions(isInTashkent(lat, lng));

  // Reverse geocode only as a *suggestion*. OSM coverage in Uzbekistan is
  // sparse, so Nominatim often snaps to a far road — the buyer must be able
  // to correct it. The picked coordinates (inp-lat/lng) are what the courier
  // navigates to; this editable text is the human-readable note alongside.
  const box = document.getElementById('location-address-box');
  const labelEl = document.getElementById('location-address-label');
  const addrEl = document.getElementById('location-address');
  box.style.display = 'block';
  labelEl.textContent = t.lblAddressEdit;
  addrEl.placeholder = t.mapPickerLoading;
  // Each new point reseeds the suggestion (picking a new spot ⇒ new address).
  const seq = (setSelectedLocation._seq = (setSelectedLocation._seq || 0) + 1);
  addrEl.value = '';
  try {
    const data = await api('/api/geocode?lat=' + lat + '&lng=' + lng);
    if (seq !== setSelectedLocation._seq) return;  // a newer pick superseded us
    addrEl.value = data.address || '';
  } catch (_) {
    if (seq !== setSelectedLocation._seq) return;
  }
  addrEl.placeholder = t.addressEditPlaceholder;
}

// ===== MAP PICKER =====
let _leafletMap = null;
let _mapGeocodeTimer = null;
const _TASHKENT_CENTER = [41.3111, 69.2797];

// Yandex tile servers — only one provider here, intentionally. Yandex
// renders tiles in EPSG:3395 (Elliptical Mercator, WGS84 ellipsoid). The
// Leaflet map below is therefore configured with crs: L.CRS.EPSG3395 so
// the visual map and the lat/lng we read back from getCenter() line up.
//
// We previously fell back to CartoDB/OSM here — but those providers serve
// EPSG:3857 (Spherical Mercator) tiles. Mixing them with a 3395-CRS map
// causes a ~5–10 km north–south displacement at Tashkent's latitude:
// the buyer would visually pick Chorsu but the coords would resolve to
// the Quyichirchiq area. We dropped the fallbacks rather than ship that
// silent address-corruption bug; if Yandex tiles fail to load we show
// a clear error instead.
const _TILE_PROVIDERS = [
  {
    url: 'https://core-renderer-tiles.maps.yandex.net/tiles?l=map&v=21.06.02&x={x}&y={y}&z={z}&scale=1&lang=ru_RU',
    maxZoom: 19,
    subdomains: '',
  },
];

function _setMapError(msg) {
  const el = document.getElementById('map-error');
  if (!el) return;
  if (msg) {
    el.textContent = msg;
    el.style.display = 'block';
  } else {
    el.style.display = 'none';
  }
}

function _addTileLayer(map, providerIdx) {
  const p = _TILE_PROVIDERS[providerIdx];
  if (!p) return null;
  const opts = { maxZoom: p.maxZoom };
  if (p.subdomains) opts.subdomains = p.subdomains;
  // window.L explicitly — our top-level `const L = {uz: ..., ru: ...}`
  // locale table shadows Leaflet's global L in this script.
  const layer = window.L.tileLayer(p.url, opts);
  let errored = false;
  layer.on('tileerror', () => {
    if (errored) return;
    errored = true;
    if (providerIdx + 1 < _TILE_PROVIDERS.length) {
      console.warn('Tile provider', providerIdx, 'failed — trying next');
      map.removeLayer(layer);
      _addTileLayer(map, providerIdx + 1);
    } else {
      _setMapError('Xaritani yuklab bo\'lmadi. Tarmoq aloqasini tekshiring.');
    }
  });
  layer.addTo(map);
  return layer;
}

function openMapPicker() {
  if (!window.L || typeof window.L.map !== 'function') {
    // Leaflet itself didn't load. Show a clear in-app message rather than
    // a toast, since the user explicitly asked for this feature.
    document.getElementById('map-modal-title').textContent = t.mapPickerTitle;
    document.getElementById('map-modal').classList.add('show');
    updateBackButton();
    _setMapError('Leaflet kutubxonasi yuklanmadi (/static/leaflet.js). Serverni qayta ishga tushirish kerak.');
    return;
  }
  document.getElementById('map-modal-title').textContent = t.mapPickerTitle;
  document.getElementById('map-confirm-btn').textContent = t.mapPickerConfirm;
  document.getElementById('map-address').textContent = t.mapPickerLoading;
  document.getElementById('map-modal').classList.add('show');
  updateBackButton();
  _setMapError(null);

  // Pick a sensible starting center: previously-saved coords > current GPS > Tashkent.
  const savedLat = parseFloat(document.getElementById('inp-lat').value);
  const savedLng = parseFloat(document.getElementById('inp-lng').value);
  let startCenter = _TASHKENT_CENTER;
  let startZoom = 12;
  if (!isNaN(savedLat) && !isNaN(savedLng)) {
    startCenter = [savedLat, savedLng];
    startZoom = 16;
  }

  // Two rAFs to let the modal switch from display:none to display:flex,
  // run flex layout, and report a real height before we hand the container
  // to Leaflet. (One frame is usually enough on Chromium; iOS WKWebView
  // sometimes needs the extra tick.)
  requestAnimationFrame(() => requestAnimationFrame(() => {
    try {
      if (!_leafletMap) {
        // crs: EPSG:3395 is mandatory — Yandex tiles are rendered in this
        // projection (WGS84 ellipsoid). Without it Leaflet treats them as
        // 3857 (spherical) and getCenter() returns coords ~5–10 km off
        // from where the buyer visually picked. See _TILE_PROVIDERS notes.
        _leafletMap = window.L.map('map-canvas', {
          crs: window.L.CRS.EPSG3395,
          zoomControl: true,
          attributionControl: false,
        }).setView(startCenter, startZoom);
        _addTileLayer(_leafletMap, 0);
        _leafletMap.on('moveend', _onMapMoveEnd);
      } else {
        _leafletMap.setView(startCenter, startZoom);
      }
      // Force Leaflet to recompute pixel dimensions now that the modal is
      // actually visible — without this, tiles draw to a 0×0 buffer and
      // the map appears blank. Repeat once with a small delay to catch
      // the case where the first frame still had transitional layout.
      _leafletMap.invalidateSize();
      setTimeout(() => _leafletMap && _leafletMap.invalidateSize(), 250);
      _onMapMoveEnd();

      // If we have no saved point, recenter on the user's GPS as a default
      // (better than landing them in the middle of Tashkent every time).
      if (isNaN(savedLat) && navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            if (_leafletMap) _leafletMap.setView([pos.coords.latitude, pos.coords.longitude], 16);
          },
          () => {},
          { enableHighAccuracy: true, timeout: 8000 }
        );
      }
    } catch (e) {
      console.error('Map init failed:', e);
      _setMapError('Xarita ishga tushmadi: ' + (e && e.message ? e.message : e));
    }
  }));
}

function closeMapPicker() {
  document.getElementById('map-modal').classList.remove('show');
  updateBackButton();
}

function _onMapMoveEnd() {
  if (!_leafletMap) return;
  const c = _leafletMap.getCenter();
  const addrEl = document.getElementById('map-address');
  addrEl.classList.add('loading');
  addrEl.textContent = t.mapPickerLoading;
  // Debounce reverse-geocode while the buyer is panning.
  clearTimeout(_mapGeocodeTimer);
  _mapGeocodeTimer = setTimeout(async () => {
    try {
      const data = await api('/api/geocode?lat=' + c.lat + '&lng=' + c.lng);
      addrEl.classList.remove('loading');
      addrEl.textContent = data.address || ('📍 ' + c.lat.toFixed(6) + ', ' + c.lng.toFixed(6));
    } catch (_) {
      addrEl.classList.remove('loading');
      addrEl.textContent = '📍 ' + c.lat.toFixed(6) + ', ' + c.lng.toFixed(6);
    }
  }, 350);
}

function confirmMapPick() {
  if (!_leafletMap) return;
  const c = _leafletMap.getCenter();
  setSelectedLocation(c.lat, c.lng);
  closeMapPicker();
}

async function submitOrder() {
  const phone = document.getElementById('inp-phone').value.trim();
  const lat = document.getElementById('inp-lat').value;
  const lng = document.getElementById('inp-lng').value;
  const payMethod = document.querySelector('.pay-opt.active')?.dataset.method || 'cash';

  // Remove old errors
  document.querySelectorAll('.checkout-error').forEach(e => e.remove());

  // Validate
  const phoneClean = phone.replace(/[\s-]/g, '');
  if (!phoneClean.match(/^\+?998\d{9}$/)) {
    const err = document.createElement('div');
    err.className = 'checkout-error';
    err.textContent = t.errorPhone;
    document.getElementById('inp-phone').after(err);
    return;
  }
  if (!lat || !lng) {
    const err = document.createElement('div');
    err.className = 'checkout-error';
    err.textContent = t.errorAddress;
    document.getElementById('btn-get-location').after(err);
    return;
  }

  const deliveryMethod = document.querySelector('.del-opt.active')?.dataset.method;
  if (!deliveryMethod) {
    showToast(t.errorDelivery, true);
    return;
  }

  const address = '📍 ' + parseFloat(lat).toFixed(6) + ', ' + parseFloat(lng).toFixed(6);
  // Optional human-readable address the buyer reviewed/corrected. Sent as
  // address_note so it renders as 📝 next to the coords for the courier.
  const addressNote = (document.getElementById('location-address')?.value || '').trim();
  const btn = document.getElementById('btn-submit-order');
  btn.disabled = true;
  btn.textContent = t.ordering;

  try {
    const result = await api('/api/checkout', {
      method: 'POST',
      body: JSON.stringify({
        phone,
        address,
        address_note: addressNote || null,
        latitude: parseFloat(lat),
        longitude: parseFloat(lng),
        payment_method: payMethod,
        delivery_method: deliveryMethod,
      })
    });

    // Clear cart locally
    cartData = { items: [], total: 0 };
    updateCartBadge();

    // Clear form
    document.getElementById('inp-phone').value = '';
    document.getElementById('inp-lat').value = '';
    document.getElementById('inp-lng').value = '';
    document.getElementById('location-text').textContent = t.btnGetLocation;
    document.getElementById('btn-get-location').classList.remove('set');
    document.getElementById('location-icon').textContent = '📍';
    const addrBox = document.getElementById('location-address-box');
    if (addrBox) addrBox.style.display = 'none';
    const addrEl = document.getElementById('location-address');
    if (addrEl) addrEl.value = '';
    document.getElementById('delivery-group').style.display = 'none';
    document.getElementById('delivery-options').innerHTML = '';

    if (result.awaiting_cheque) {
      // Online payment — go to cheque-upload page directly inside the
      // Mini App instead of bouncing the buyer back to the bot chat.
      openChequePage(result);
    } else {
      // Cash flow — show the standard success screen.
      document.getElementById('order-success-text').textContent = t.orderSuccess;
      document.getElementById('order-success-detail').textContent =
        t.orderSuccessDetail.replace('{id}', result.order_id);
      document.getElementById('order-success-detail').style.whiteSpace = 'pre-line';
      switchPage('order-success');
    }

    if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
  } catch(e) {
    console.error('Checkout error:', e);
    if (e && e.body && e.body.error === 'outside_uzbekistan') {
      const err = document.createElement('div');
      err.className = 'checkout-error';
      err.textContent = t.errorOutsideUzbekistan;
      document.getElementById('btn-get-location').after(err);
      // Reset location so user must re-share
      document.getElementById('inp-lat').value = '';
      document.getElementById('inp-lng').value = '';
      document.getElementById('location-text').textContent = t.btnGetLocation;
      document.getElementById('btn-get-location').classList.remove('set');
      document.getElementById('location-icon').textContent = '📍';
      const addrBox = document.getElementById('location-address-box');
      if (addrBox) addrBox.style.display = 'none';
      const addrEl = document.getElementById('location-address');
      if (addrEl) addrEl.value = '';
    } else if (e && e.body && e.body.error === 'stock_gone') {
      showToast(t.errorStockGone, true);
      // Refresh cart so the user sees the gap before retrying
      await loadCart();
      switchPage('cart');
    } else if (e && e.status === 403) {
      showToast(t.errorSessionExpired, true);
    } else {
      showToast(t.errorLoad, true);
    }
  } finally {
    btn.disabled = false;
    btn.textContent = t.submitOrder;
  }
}

