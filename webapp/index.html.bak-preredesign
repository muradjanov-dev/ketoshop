  textEl.textContent = t.btnLocationLoading;

  if (!navigator.geolocation) {
    textEl.textContent = t.errorLocation;
    btn.disabled = false;
    return;
  }

  navigator.geolocation.getCurrentPosition(
    (pos) => {
      setSelectedLocation(pos.coords.latitude, pos.coords.longitude);
      btn.disabled = false;
    },
    (err) => {
      console.error('Geolocation error:', err);
      textEl.textContent = t.btnGetLocation;
      btn.disabled = false;
      showToast(t.errorLocation, true);
