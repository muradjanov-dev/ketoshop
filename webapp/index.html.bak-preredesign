// ===== Latin → Uzbek Cyrillic transliteration =====
// Mirrors translit.py — same brand skip list, same digraph order so the
// Mini App and bot stay in lockstep.
const _UZ_BRANDS = ['Yandex Taxi','Yandex Market','Yandex','KETOSHOP','Ketoshop','Telegram','BTS','EMU','UZS'];
const _UZ_DIGRAPHS = [
  // o' / g' before yo/yu/ya so "yo'l" → й + ў + л (not ё + ъ).
  ["O'",'Ў'],["o'",'ў'],
  ["G'",'Ғ'],["g'",'ғ'],
  ['Oʻ','Ў'],['oʻ','ў'],
  ['Gʻ','Ғ'],['gʻ','ғ'],
  ['Sh','Ш'],['SH','Ш'],['sh','ш'],
  ['Ch','Ч'],['CH','Ч'],['ch','ч'],
  ['Yo','Ё'],['YO','Ё'],['yo','ё'],
  ['Yu','Ю'],['YU','Ю'],['yu','ю'],
  ['Ya','Я'],['YA','Я'],['ya','я'],
  ['Ye','Е'],['YE','Е'],['ye','е'],
];
const _UZ_SINGLES = {
  a:'а',b:'б',d:'д',e:'е',f:'ф',g:'г',h:'ҳ',i:'и',j:'ж',k:'к',l:'л',m:'м',
  n:'н',o:'о',p:'п',q:'қ',r:'р',s:'с',t:'т',u:'у',v:'в',x:'х',y:'й',z:'з',"'":'ъ','ʻ':'ъ',
  A:'А',B:'Б',D:'Д',E:'Е',F:'Ф',G:'Г',H:'Ҳ',I:'И',J:'Ж',K:'К',L:'Л',M:'М',
  N:'Н',O:'О',P:'П',Q:'Қ',R:'Р',S:'С',T:'Т',U:'У',V:'В',X:'Х',Y:'Й',Z:'З',
};
function latToCyr(text) {
  if (!text || typeof text !== 'string') return text;
  // Stash HTML tags, {format_tokens}, and brand names so they survive intact.
  const store = [];
  const stash = (m) => { store.push(m); return '' + (store.length - 1) + ''; };
  text = text.replace(/<[^>]+>/g, stash);
  text = text.replace(/\{[^{}]*\}/g, stash);
  // Telegram bot commands like /skip /done — must remain typeable
  text = text.replace(/(^|\s)\/[a-zA-Z][a-zA-Z0-9_]*/g, (m, lead) => lead + stash(m.slice(lead.length)));
  for (const b of _UZ_BRANDS) {
    if (text.includes(b)) {
      // Escape regex metachars
      const esc = b.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      text = text.replace(new RegExp(esc, 'g'), stash);
    }
  }
  // Digraphs in order
  for (const [from, to] of _UZ_DIGRAPHS) {
    if (text.includes(from)) text = text.split(from).join(to);
  }
  // Single letters
  text = Array.from(text).map((ch) => _UZ_SINGLES[ch] !== undefined ? _UZ_SINGLES[ch] : ch).join('');
  // Restore stashed pieces
  text = text.replace(/(\d+)/g, (_, i) => store[Number(i)]);
  return text;
}

// Build the active locale dict. "uz_cyr" auto-derives from L.uz so the
// Mini App doesn't need a third hand-written string table.
function buildActiveLocale() {
  if (lang === 'uz_cyr') {
    const base = L.uz;
    const out = {};
    for (const k in base) {
      out[k] = (typeof base[k] === 'string') ? latToCyr(base[k]) : base[k];
    }
    return out;
  }
  return L[lang] || L.uz;
}

