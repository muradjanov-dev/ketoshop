// No chequeOrderId: the order is only created on the server when the cheque
// arrives, so we don't have an ID until /api/checkout/cheque returns success.
let chequeFile = null;

function openChequePage(result) {
  chequeFile = null;

  document.getElementById('cheque-title').textContent = t.chequeTitle;
  // The order doesn't exist yet — leave the #N line blank rather than
