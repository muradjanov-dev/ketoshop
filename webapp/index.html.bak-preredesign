async function switchLanguage(newLang) {
  const btns = document.querySelectorAll('.lang-btn');
  btns.forEach(b => b.disabled = true);
  try {
    lang = newLang;
    t = buildActiveLocale();
    try { localStorage.setItem('ketoshop_lang', lang); } catch (_) { /* quota — ignore */ }
    applyLanguage();
    // Save to server
    try { await api('/api/lang', { method: 'POST', body: JSON.stringify({ lang }) }); } catch (_) { /* server-side preference is best-effort */ }
    // Reload dynamic content
    renderCatalogCategories();
    loadProducts();
    renderHomePage();
    if (activePage === 'cart') renderCartPage();
    if (activePage === 'profile') renderProfilePage();
    if (activePage === 'fav') renderFavPage();
    if (activePage === 'orders') loadOrdersPage();
  } finally {
    btns.forEach(b => b.disabled = false);
  }
}

// ===== AUTH =====
const AUTH = 'tma ' + tg.initData;
function apiHeaders() {
  return { 'Authorization': AUTH, 'Content-Type': 'application/json' };
}
async function api(path, opts = {}) {
  const res = await fetch(path, { headers: apiHeaders(), ...opts });
  if (!res.ok) {
    let body = null;
    try { body = await res.json(); } catch(_) {}
    const err = new Error(res.status);
    err.status = res.status;
    err.body = body;
    throw err;
  }
  return res.json();
}

