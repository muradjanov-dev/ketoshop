<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Ketoshop</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<!-- Leaflet for the map-picker modal. Self-hosted under /static/ so we
     don't depend on third-party CDN reachability from Uzbekistan
     (cdnjs/unpkg can be slow or blocked, leaving the map blank). -->
<link rel="stylesheet" href="/static/leaflet.css">
<script src="/static/leaflet.js"></script>
<style>
  :root {
    --bg: var(--tg-theme-bg-color, #fff);
    --text: var(--tg-theme-text-color, #222);
    --hint: var(--tg-theme-hint-color, #999);
    --link: var(--tg-theme-link-color, #2678b6);
    --btn: var(--tg-theme-button-color, #3390ec);
    --btn-text: var(--tg-theme-button-text-color, #fff);
    --secondary-bg: var(--tg-theme-secondary-bg-color, #f0f0f0);
    --tab-bar-h: 56px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    -webkit-user-select: none;
    user-select: none;
    padding-bottom: 66px;
    overflow-x: hidden;
  }

  /* ===== PAGE SYSTEM ===== */
  .page { display: none; min-height: calc(100dvh - 58px - env(safe-area-inset-bottom, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px); }
  .page.active { display: block; }

  /* ===== BOTTOM TAB BAR ===== */
  .tab-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    min-height: 58px;
    background: #ffffff;
    background: var(--bg, #ffffff);
    border-top: 1px solid #e0e0e0;
    box-shadow: 0 -1px 8px rgba(0,0,0,0.06);
    display: flex;
    z-index: 9999;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 44px;
    cursor: pointer;
    color: var(--hint);
    transition: color .2s;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }
  .tab-item.active { color: var(--btn); }
  .tab-item svg { width: 24px; height: 24px; }
  .tab-item span { font-size: 10px; font-weight: 500; }
  .tab-badge {
    position: absolute;
    top: 4px;
    right: calc(50% - 18px);
    background: #c62828;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }
  .tab-badge.visible { display: flex; }

  /* ===== SEARCH ===== */
  .search-wrap { position: relative; }
  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--hint);
  }

  /* ===== HOME PAGE ===== */
  .home-section {
    margin-bottom: 0;
    padding-bottom: 6px;
    border-bottom: 8px solid var(--secondary-bg);
  }
  .home-section:last-child { border-bottom: none; }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 14px 10px;
  }
  .section-title {
    font-size: 18px;
    font-weight: 700;
  }
  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    color: var(--btn);
    cursor: pointer;
    white-space: nowrap;
    background: rgba(51, 144, 236, 0.1);
    border: none;
    border-radius: 16px;
    padding: 6px 14px;
    font-family: inherit;
  }
  .carousel {
    display: flex;
    overflow-x: auto;
    gap: 12px;
    padding: 0 14px 14px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .carousel::-webkit-scrollbar { display: none; }

  .carousel-card {
    flex-shrink: 0;
    width: 170px;
    scroll-snap-align: start;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .carousel-card:active { opacity: 0.85; }
  .carousel-card .card-img-wrap {
    position: relative;
    width: 170px;
    height: 170px;
  }
  .carousel-card .card-img {
    width: 170px;
    height: 170px;
    border-radius: 14px;
    object-fit: cover;
    background: var(--secondary-bg);
    display: block;
  }
  .carousel-card .no-photo {
    width: 170px;
    height: 170px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--secondary-bg);
    font-size: 36px;
    color: var(--hint);
  }
  /* ===== TOP-3 PODIUM (home) ===== */
  .podium {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 10px;
    padding: 8px 14px 18px;
  }
  .podium-item {
    flex: 1 1 0;
    max-width: 33%;
    background: var(--secondary-bg);
    border-radius: 14px;
    padding: 8px 6px 10px;
    text-align: center;
    cursor: pointer;
    position: relative;
    border: 2px solid transparent;
    -webkit-tap-highlight-color: transparent;
  }
  .podium-item:active { opacity: 0.85; }
  .podium-item.rank-1 {
    transform: translateY(-12px);
    border-color: #ffcc33;
    box-shadow: 0 6px 18px rgba(255, 196, 0, 0.25);
  }
  .podium-item.rank-2 { border-color: #b9c3cf; }
  .podium-item.rank-3 { border-color: #d99a5b; }
  .podium-medal { font-size: 22px; line-height: 1; margin-bottom: 4px; }
  .podium-item.rank-1 .podium-medal { font-size: 28px; }
  .podium-img, .podium-nophoto {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    object-fit: cover;
    background: var(--bg);
    display: block;
  }
  .podium-nophoto {
    display: flex; align-items: center; justify-content: center;
    font-size: 30px; color: var(--hint);
  }
  .podium-name {
    font-size: 12px; font-weight: 600; margin-top: 6px;
    line-height: 1.25; max-height: 2.5em; overflow: hidden;
  }
  .podium-price { font-size: 12px; font-weight: 700; margin-top: 3px; color: var(--text); }
  .card-fav-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 36px;
    height: 36px;
    padding: 4px;
    box-sizing: content-box;
    border-radius: 50%;
    background: rgba(255,255,255,0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    font-size: 16px;
    line-height: 1;
    -webkit-tap-highlight-color: transparent;
  }
  .carousel-card .card-price {
    font-size: 15px;
    font-weight: 800;
    margin-top: 8px;
    color: var(--text);
  }
  .carousel-card .card-name {
    font-size: 13px;
    color: var(--hint);
    margin-top: 3px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  /* ===== CATALOG PAGE ===== */
  .categories {
    display: flex;
    overflow-x: auto;
    gap: 8px;
    padding: 8px 12px;
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .categories::-webkit-scrollbar { display: none; }
  .cat-tab {
    flex-shrink: 0;
    padding: 8px 16px;
    border-radius: 20px;
    background: var(--secondary-bg);
    color: var(--text);
    border: none;
    font-size: 13px;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
    font-family: inherit;
  }
  .cat-tab.active {
    background: var(--btn);
    color: var(--btn-text);
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 8px 12px 16px;
  }
  .product-card {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .product-card:active { opacity: 0.85; }
  .product-card .card-img-wrap {
    position: relative;
  }
  .product-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 14px;
    background: var(--secondary-bg);
    display: block;
  }
  .product-card .no-photo {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--secondary-bg);
    font-size: 40px;
    color: var(--hint);
  }
  .product-card .card-price {
    font-size: 15px;
    font-weight: 800;
    margin-top: 8px;
    color: var(--text);
  }
  /* Discount styling — used in carousel cards, catalog cards, detail modal, cart */
  .price-old {
    color: var(--hint);
    text-decoration: line-through;
    font-weight: 500;
    font-size: 0.85em;
    margin-right: 6px;
  }
  .price-new {
    color: #c62828;
    font-weight: 800;
  }
  .discount-badge {
    display: inline-block;
    background: #c62828;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 6px;
    margin-left: 6px;
    vertical-align: middle;
    line-height: 1.2;
  }
  .card-img-wrap .discount-corner {
    position: absolute;
    top: 6px;
    left: 6px;
    background: #c62828;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 8px;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .card-img-wrap .disc-until-corner {
    position: absolute;
    top: 6px;
    right: 6px;
    background: rgba(0,0,0,0.62);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 8px;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .product-card .card-name {
    font-size: 13px;
    color: var(--hint);
    margin-top: 3px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }
  .product-card .card-desc,
  .carousel-card .card-desc {
    font-size: 11px;
    color: var(--hint);
    opacity: 0.7;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .catalog-search-bar {
    padding: 8px 12px 0;
  }
  .catalog-search-bar input {
    width: 100%;
    padding: 10px 14px 10px 36px;
    border-radius: 12px;
    border: none;
    background: var(--secondary-bg);
    color: var(--text);
    font-size: 14px;
    outline: none;
  }
  .catalog-search-bar input::placeholder { color: var(--hint); }

  /* ===== CART PAGE ===== */
  .cart-page-content { padding: 0 0 100px; }
  .cart-page-header {
    padding: 16px 14px 8px;
    font-size: 18px;
    font-weight: 700;
  }
  .cart-item {
    display: flex;
    align-items: center;
    padding: 12px 14px;
    gap: 12px;
    border-bottom: 1px solid var(--secondary-bg);
  }
  .cart-item img {
    width: 56px; height: 56px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--secondary-bg);
  }
  .cart-item .no-photo-sm {
    width: 56px; height: 56px;
    border-radius: 10px;
    background: var(--secondary-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }
  .cart-item .item-info { flex: 1; min-width: 0; }
  .cart-item .item-name {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cart-item .item-meta { font-size: 12px; color: var(--hint); margin-top: 2px; }
  .cart-item .item-price { font-weight: 700; font-size: 14px; white-space: nowrap; margin-left: 8px; }
  .cart-item .remove-btn {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #c62828;
    padding: 4px;
    margin-left: 4px;
  }
  /* Inline qty stepper inside each cart line. Compact (28px tall) so it
     fits without pushing other rows down, but still meets a usable touch
     target with surrounding padding. */
  .cart-item .qty-stepper {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    background: var(--secondary-bg);
    border-radius: 999px;
    padding: 2px 4px;
    width: fit-content;
  }
  .cart-item .qty-step {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg);
    border: none;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
  }
  .cart-item .qty-step:disabled { opacity: 0.5; cursor: default; }
  .cart-item .qty-step-value {
    min-width: 28px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .cart-footer {
    position: fixed;
    bottom: 58px;
    left: 0;
    right: 0;
    background: var(--bg);
    border-top: 1px solid var(--secondary-bg);
    padding: 12px 14px;
    z-index: 50;
  }
  .cart-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .cart-saved-banner {
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: linear-gradient(135deg, #43a047, #2e7d32);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    padding: 9px 12px;
    border-radius: 10px;
    margin-bottom: 10px;
    box-shadow: 0 2px 8px rgba(46,125,50,0.28);
  }
  .cart-actions {
    display: flex;
    gap: 10px;
  }
  .cart-actions button {
    flex: 1;
    padding: 13px;
    border-radius: 12px;
    border: none;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }
  .btn-clear {
    background: var(--secondary-bg);
    color: var(--text);
  }
  .btn-checkout {
    background: var(--btn);
    color: var(--btn-text);
  }

  /* ===== CHECKOUT PAGE ===== */
  .checkout-content { padding: 0 14px 24px; }
  .checkout-header {
    padding: 16px 0 12px;
    font-size: 18px;
    font-weight: 700;
  }
  .checkout-summary {
    background: var(--secondary-bg);
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 16px;
    font-size: 13px;
    line-height: 1.6;
  }
  .checkout-summary .summary-item { color: var(--text); }
  .checkout-summary .summary-item .s-qty { color: var(--hint); }
  .checkout-form { margin-bottom: 16px; }
  .form-group {
    margin-bottom: 14px;
  }
  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--hint);
  }
  .form-group input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid var(--secondary-bg);
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    outline: none;
    font-family: inherit;
    transition: border-color .2s;
  }
  .form-group input:focus {
    border-color: var(--btn);
  }
  .payment-options {
    display: flex;
    gap: 10px;
  }
  .pay-opt, .del-opt {
    flex: 1;
    padding: 12px;
    border-radius: 12px;
    border: 1.5px solid var(--secondary-bg);
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: all .2s;
    text-align: center;
  }
  .pay-opt.active, .del-opt.active {
    border-color: var(--btn);
    background: rgba(51,144,236,0.08);
    color: var(--btn);
  }
  .delivery-options-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .delivery-options-list .del-opt {
    flex: 1 1 calc(50% - 5px);
    min-width: 0;
  }
  .checkout-total {
    display: flex;
    justify-content: space-between;
    font-size: 17px;
    font-weight: 700;
    padding: 12px 0;
    border-top: 1px solid var(--secondary-bg);
    margin-bottom: 16px;
  }
  .checkout-submit-btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: var(--btn);
    color: var(--btn-text);
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }
  .checkout-submit-btn:active { opacity: 0.8; }
  .checkout-submit-btn:disabled { opacity: 0.5; cursor: default; }
  .checkout-back-btn {
    display: block;
    width: 100%;
    margin-top: 10px;
    padding: 12px;
    background: var(--secondary-bg);
    color: var(--text);
    border: none;
    border-radius: 12px;
    font-size: 14px;
    cursor: pointer;
    font-family: inherit;
  }
  .location-btn {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid var(--secondary-bg);
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    cursor: pointer;
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all .2s;
  }
  .location-btn.set {
    border-color: #4caf50;
    background: rgba(76,175,80,0.06);
    color: #2e7d32;
  }
  .location-btn:disabled { opacity: 0.6; }
  .map-pick-btn { margin-top: 8px; }
  .location-address-box { margin-top: 8px; }
  .location-address-label {
    display: block;
    font-size: 12px;
    color: var(--hint);
    margin-bottom: 6px;
    line-height: 1.35;
  }
  .location-address-input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 12px;
    background: var(--secondary-bg);
    border: 1px solid var(--secondary-bg);
    border-radius: 8px;
    font-size: 13px;
    color: var(--text);
    line-height: 1.4;
    font-family: inherit;
    resize: vertical;
    min-height: 40px;
  }
  .location-address-input:focus {
    outline: none;
    border-color: var(--accent, #2e7d32);
  }

  /* ===== MAP PICKER MODAL ===== */
  .map-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--bg);
    /* Above tab bar (z:9999) so the bottom Confirm button is reachable. */
    z-index: 10001;
    flex-direction: column;
  }
  .map-modal.show { display: flex; }
  .map-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    padding-top: calc(14px + env(safe-area-inset-top, 0px));
    border-bottom: 1px solid var(--secondary-bg);
    flex-shrink: 0;
  }
  .map-modal-header h2 { font-size: 16px; font-weight: 700; }
  .map-modal-body {
    flex: 1;
    position: relative;
    /* Explicit min-height so the body has size even if a webview reports
       0 for flex:1 briefly after the modal switches to display:flex —
       Leaflet refuses to render in a zero-height container. */
    min-height: 240px;
  }
  #map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: var(--secondary-bg);
  }
  /* Override Leaflet's tile background that bleeds through with our hint
     color, in case tiles are loading. */
  .leaflet-container { background: var(--secondary-bg); }
  #map-error {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    padding: 14px 18px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.45;
    max-width: 86%;
    text-align: center;
    z-index: 3;
  }
  /* Center crosshair sits on top of the map; the map slides under it
     when the user pans, so wherever the crosshair points is the picked
     spot. Avoids the marker-drag awkwardness on touch screens. */
  .map-crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -100%);
    font-size: 32px;
    pointer-events: none;
    z-index: 2;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4));
  }
  .map-modal-footer {
    padding: 12px 14px calc(12px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--secondary-bg);
    background: var(--bg);
    flex-shrink: 0;
  }
  .map-address {
    font-size: 13px;
    color: var(--text);
    margin-bottom: 10px;
    min-height: 36px;
    padding: 8px 12px;
    background: var(--secondary-bg);
    border-radius: 8px;
    line-height: 1.4;
  }
  .map-address.loading { color: var(--hint); }
  .checkout-error {
    color: #c62828;
    font-size: 13px;
    margin-top: 4px;
  }

  /* ===== FAVORITES PAGE ===== */
  .fav-header {
    padding: 16px 14px 8px;
    font-size: 18px;
    font-weight: 700;
  }

  /* ===== CHEQUE UPLOAD PAGE ===== */
  .cheque-page { padding: 18px 14px 24px; }
  .cheque-title { font-size: 18px; font-weight: 700; color: var(--text); }
  .cheque-order { font-size: 14px; color: var(--hint); margin-top: 4px; }
  .cheque-total {
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    margin: 14px 0 18px;
  }
  .cheque-row {
    background: var(--secondary-bg);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 10px;
  }
  .cheque-row-label { font-size: 12px; color: var(--hint); margin-bottom: 4px; }
  .cheque-row-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    word-break: break-all;
  }
  .cheque-row-value code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 16px;
    letter-spacing: 0.5px;
    color: var(--text);
  }
  .cheque-copy {
    flex-shrink: 0;
    background: var(--bg);
    border: 1px solid var(--secondary-bg);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    color: var(--btn);
    font-family: inherit;
  }
  .cheque-copy:active { opacity: 0.7; }
  .cheque-hint {
    font-size: 13px;
    color: var(--hint);
    margin: 14px 0 12px;
    line-height: 1.5;
  }
  .cheque-pick-btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: var(--secondary-bg);
    border: 2px dashed var(--hint);
    border-radius: 12px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    margin-bottom: 12px;
  }
  .cheque-pick-btn.has-file {
    border-style: solid;
    border-color: var(--btn);
    background: var(--bg);
  }
  #cheque-preview {
    margin: 0 0 12px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--secondary-bg);
  }
  #cheque-preview img {
    width: 100%;
    max-height: 320px;
    object-fit: contain;
    display: block;
    background: var(--secondary-bg);
  }
  #cheque-preview .doc-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px;
    font-size: 14px;
    color: var(--text);
    background: var(--secondary-bg);
  }
  .cheque-pay-later-btn {
    display: block;
    width: 100%;
    margin-top: 10px;
    padding: 12px;
    background: transparent;
    color: var(--hint);
    border: none;
    border-radius: 12px;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    text-decoration: underline;
  }

  /* ===== PROFILE PAGE ===== */
  .profile-content { padding: 24px 14px; }
  .profile-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--secondary-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    margin: 0 auto 12px;
    color: var(--hint);
  }
  .profile-name {
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .profile-meta {
    text-align: center;
    font-size: 13px;
    color: var(--hint);
    margin-bottom: 24px;
  }
  .profile-menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--secondary-bg);
    cursor: pointer;
    font-size: 15px;
  }
  .profile-menu-item svg {
    width: 20px;
    height: 20px;
    color: var(--hint);
    flex-shrink: 0;
  }
  .lang-toggle {
    display: flex;
    gap: 6px;
  }
  .lang-btn {
    padding: 6px 12px;
    border-radius: 8px;
    border: 1.5px solid var(--secondary-bg);
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: all .2s;
  }
  .lang-btn.active {
    border-color: var(--btn);
    background: rgba(51,144,236,0.1);
    color: var(--btn);
    font-weight: 600;
  }

  /* ===== PRODUCT DETAIL MODAL ===== */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    /* Above the bottom tab-bar (z:9999) — otherwise the tab-bar
       covers the modal's sticky footer (qty + Add to cart button)
       and buyers can't see/tap it. */
    z-index: 10000;
    align-items: flex-end;
    justify-content: center;
  }
  .modal-overlay.show { display: flex; }

  .modal {
    background: var(--bg);
    border-radius: 16px 16px 0 0;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom, 0);
    animation: slideUp .25s ease-out;
  }
  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid var(--secondary-bg);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 1;
  }
  .modal-header h2 { font-size: 17px; flex: 1; }
  .modal-close {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--secondary-bg);
    border: none;
    font-size: 18px;
    cursor: pointer;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal img.detail-img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
  }
  .modal video.detail-video {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
  }
  .detail-media-carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .detail-media-carousel::-webkit-scrollbar { display: none; }
  .detail-media-carousel .media-slide {
    flex-shrink: 0;
    width: 100%;
    scroll-snap-align: start;
  }
  .detail-media-carousel .media-slide img,
  .detail-media-carousel .media-slide video {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    display: block;
  }
  .media-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 8px 0;
  }
  .media-dots .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hint);
    opacity: 0.3;
    transition: opacity .2s;
  }
  .media-dots .dot.active { opacity: 1; }
  .modal .detail-body { padding: 16px; padding-bottom: 8px; }
  /* Sticky footer keeps qty + "Add to cart" visible even when the
     description is long — on desktop the modal scrolls and the
     button would otherwise sit below the fold. */
  .modal .detail-footer {
    position: sticky;
    bottom: 0;
    background: var(--bg);
    padding: 8px 16px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--secondary-bg);
    z-index: 1;
  }
  .modal .detail-price {
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
  }
  .detail-saving {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
    color: #2e7d32;
  }
  .card-saving {
    font-size: 11px;
    font-weight: 700;
    color: #2e7d32;
    margin-top: 2px;
  }
  .item-saving {
    font-size: 11px;
    font-weight: 700;
    color: #2e7d32;
    margin-top: 2px;
  }
  .modal .detail-unit {
    font-size: 13px;
    color: var(--hint);
  }
  .modal .detail-desc {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    opacity: 0.8;
    white-space: pre-line;
  }
  .modal .detail-rating {
    margin-top: 8px;
    font-size: 13px;
    color: var(--hint);
  }
  .modal .detail-seller {
    margin-top: 4px;
    font-size: 12px;
    color: var(--hint);
  }
  .modal .detail-fav-btn {
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    padding: 4px;
    margin-left: 8px;
  }

  .qty-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
    justify-content: center;
  }
  .qty-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--secondary-bg);
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qty-value {
    font-size: 18px;
    font-weight: 600;
    min-width: 30px;
    text-align: center;
  }

  .add-to-cart-btn {
    display: block;
    width: 100%;
    margin-top: 16px;
    padding: 14px;
    background: var(--btn);
    color: var(--btn-text);
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }
  .add-to-cart-btn:active { opacity: 0.8; }

  /* ===== SHARED ===== */
  .loading {
    text-align: center;
    padding: 40px;
    color: var(--hint);
    font-size: 14px;
  }
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--hint);
  }
  .empty-state .emoji { font-size: 48px; margin-bottom: 12px; }

  /* ===== ORDERS PAGE ===== */
  .orders-header {
    padding: 16px 14px 8px;
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }
  .order-card {
    margin: 8px 12px;
    background: var(--secondary-bg);
    border-radius: 14px;
    padding: 12px 14px;
  }
  .order-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .order-id { font-weight: 700; color: var(--text); font-size: 15px; }
  .order-total { font-weight: 700; color: var(--text); font-size: 15px; }
  .order-status {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    margin-left: 6px;
  }
  .order-status.pending   { background: rgba(245,158,11,0.15);  color: #d97706; }
  .order-status.confirmed { background: rgba(59,130,246,0.15);  color: #2563eb; }
  .order-status.shipped   { background: rgba(139,92,246,0.15);  color: #7c3aed; }
  .order-status.delivered { background: rgba(16,185,129,0.15);  color: #059669; }
  .order-status.cancelled { background: rgba(229,57,53,0.15);   color: #c62828; }
  .order-meta {
    font-size: 12px;
    color: var(--hint);
    margin: 2px 0;
    line-height: 1.5;
  }
  .order-items {
    margin: 8px 0;
    font-size: 13px;
    color: var(--text);
    line-height: 1.5;
  }
  .order-timeline {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 11px;
    color: var(--hint);
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1px solid rgba(127,127,127,0.15);
  }
  .order-timeline span { white-space: nowrap; }
  .order-cancel-btn {
    margin-top: 10px;
    width: 100%;
    padding: 10px;
    background: rgba(229,57,53,0.1);
    color: #c62828;
    border: 1px solid rgba(229,57,53,0.3);
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .order-cancel-btn:active { background: rgba(229,57,53,0.2); }
  .order-cancel-btn:disabled { opacity: 0.5; cursor: default; }

  .scroll-loader {
    text-align: center;
    padding: 16px;
    color: var(--hint);
    font-size: 13px;
  }
  .scroll-loader .spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid var(--secondary-bg);
    border-top-color: var(--btn);
    border-radius: 50%;
    animation: spin .6s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Skeleton shimmer for loading */
  .skeleton {
    background: var(--secondary-bg);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  .skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
</style>
</head>
<body>

<!-- ===== PAGE: HOME ===== -->
<div class="page active" id="page-home">
  <div id="home-sections"></div>
  <div class="loading" id="home-loading" style="display:none"></div>
</div>

<!-- ===== PAGE: CATALOG ===== -->
<div class="page" id="page-catalog">
  <div class="catalog-search-bar">
    <div class="search-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" id="catalog-search" placeholder="...">
    </div>
  </div>
  <div class="categories" id="categories"></div>
  <div class="product-grid" id="product-grid"></div>
  <div class="loading" id="catalog-loading" style="display:none"></div>
  <div class="empty-state" id="catalog-empty" style="display:none">
    <div class="emoji">😔</div>
    <div id="catalog-empty-text"></div>
  </div>
  <div class="scroll-loader" id="scroll-loader" style="display:none"><span class="spinner"></span></div>
</div>

<!-- ===== PAGE: CART ===== -->
<div class="page" id="page-cart">
  <div class="cart-page-content">
    <div class="cart-page-header" id="cart-page-title"></div>
    <div id="cart-items"></div>
    <div class="empty-state" id="cart-empty" style="display:none">
      <div class="emoji">🛒</div>
      <div id="cart-empty-text"></div>
    </div>
  </div>
  <div class="cart-footer" id="cart-footer" style="display:none">
    <div class="cart-saved-banner" id="cart-saved-banner" style="display:none"></div>
    <div class="cart-total-row">
      <span id="cart-total-label"></span>
      <span id="cart-total-value"></span>
    </div>
    <div class="cart-actions">
      <button class="btn-clear" onclick="clearCart()" id="btn-clear-cart"></button>
      <button class="btn-checkout" onclick="checkout()" id="btn-checkout"></button>
    </div>
  </div>
</div>

<!-- ===== PAGE: CHECKOUT ===== -->
<div class="page" id="page-checkout">
  <div class="checkout-content">
    <div class="checkout-header" id="checkout-title"></div>

    <div class="checkout-summary" id="checkout-summary"></div>

    <div class="checkout-form">
      <div class="form-group">
        <label id="lbl-phone"></label>
        <input type="tel" id="inp-phone" placeholder="+998901234567" autocomplete="tel">
      </div>
      <div class="form-group">
        <label id="lbl-location"></label>
        <button class="location-btn" id="btn-get-location" onclick="getLocation()">
          <span id="location-icon">📍</span>
          <span id="location-text"></span>
        </button>
        <button class="location-btn map-pick-btn" id="btn-pick-on-map" onclick="openMapPicker()" type="button">
          <span>🗺️</span>
          <span id="map-pick-text"></span>
        </button>
        <div class="location-address-box" id="location-address-box" style="display:none">
          <label class="location-address-label" id="location-address-label" for="location-address"></label>
          <textarea class="location-address-input" id="location-address" rows="2" maxlength="500"></textarea>
        </div>
        <input type="hidden" id="inp-lat" value="">
        <input type="hidden" id="inp-lng" value="">
      </div>
      <div class="form-group" id="delivery-group" style="display:none">
        <label id="lbl-delivery"></label>
        <div class="delivery-options-list" id="delivery-options"></div>
      </div>
      <div class="form-group">
        <label id="lbl-payment"></label>
        <div class="payment-options">
          <button class="pay-opt active" data-method="cash" id="pay-cash"></button>
          <button class="pay-opt" data-method="online" id="pay-online"></button>
        </div>
      </div>
    </div>

    <div class="checkout-total" id="checkout-total-row"></div>
    <button class="checkout-submit-btn" id="btn-submit-order" onclick="submitOrder()"></button>
    <button class="checkout-back-btn" onclick="switchPage('cart')" id="btn-checkout-back"></button>
  </div>
</div>

<!-- ===== PAGE: ORDER SUCCESS ===== -->
<div class="page" id="page-order-success">
  <div class="empty-state" style="padding-top:100px">
    <div class="emoji">✅</div>
    <div id="order-success-text" style="font-size:16px;font-weight:600;color:var(--text)"></div>
    <div id="order-success-detail" style="margin-top:8px"></div>
    <button class="checkout-submit-btn" style="margin-top:24px;width:80%" onclick="switchPage('home')" id="btn-continue-shopping"></button>
  </div>
</div>

<!-- ===== PAGE: CHEQUE UPLOAD (online payment) ===== -->
<div class="page" id="page-cheque">
  <div class="cheque-page">
    <div class="cheque-title" id="cheque-title"></div>
    <div class="cheque-order" id="cheque-order"></div>
    <div class="cheque-total" id="cheque-total"></div>

    <div class="cheque-row">
      <div class="cheque-row-label" id="cheque-card-label"></div>
      <div class="cheque-row-value">
        <code id="cheque-card-value"></code>
        <button class="cheque-copy" id="cheque-copy-card" type="button"></button>
      </div>
    </div>
    <div class="cheque-row">
      <div class="cheque-row-label" id="cheque-recipient-label"></div>
      <div class="cheque-row-value">
        <span id="cheque-recipient-value"></span>
      </div>
    </div>

    <div class="cheque-hint" id="cheque-hint"></div>

    <input type="file" id="cheque-file" accept="image/*,application/pdf" style="display:none" onchange="onChequeFileSelected(event)">
    <button class="cheque-pick-btn" id="cheque-pick-btn" type="button" onclick="document.getElementById('cheque-file').click()"></button>
    <div id="cheque-preview" style="display:none"></div>

    <button class="checkout-submit-btn" id="cheque-submit-btn" type="button" onclick="submitCheque()" disabled></button>
    <button class="cheque-pay-later-btn" id="cheque-pay-later-btn" type="button" onclick="closeMiniAppForChat()"></button>
  </div>
</div>

<!-- ===== PAGE: FAVORITES ===== -->
<div class="page" id="page-fav">
  <div class="fav-header" id="fav-title"></div>
  <div class="product-grid" id="fav-grid"></div>
  <div class="empty-state" id="fav-empty" style="display:none">
    <div class="emoji">💛</div>
    <div id="fav-empty-text"></div>
  </div>
</div>

<!-- ===== PAGE: PROFILE ===== -->
<div class="page" id="page-profile">
  <div class="profile-content">
    <div class="profile-avatar" id="profile-avatar">👤</div>
    <div class="profile-name" id="profile-name"></div>
    <div class="profile-meta" id="profile-lang"></div>
    <div id="profile-menu"></div>
  </div>
</div>

<!-- ===== PAGE: ORDERS ===== -->
<div class="page" id="page-orders">
  <div class="orders-header" id="orders-title"></div>
  <div id="orders-list"></div>
  <div class="empty-state" id="orders-empty" style="display:none">
    <div class="emoji">📭</div>
    <div id="orders-empty-text"></div>
  </div>
</div>

<!-- ===== PRODUCT DETAIL MODAL ===== -->
<div class="modal-overlay" id="detail-modal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="detail-name"></h2>
      <button class="detail-fav-btn" id="detail-fav-btn" onclick="toggleFavFromDetail()">♡</button>
      <button class="modal-close" onclick="closeDetail()">&times;</button>
    </div>
    <div id="detail-photo-container"></div>
    <div class="detail-body">
      <div><span class="detail-price" id="detail-price"></span> <span class="detail-unit" id="detail-unit"></span></div>
      <div class="detail-saving" id="detail-saving" style="display:none"></div>
      <div class="detail-discount-until" id="detail-discount-until" style="margin-top:6px;font-size:12px;color:#c62828;font-weight:600"></div>
      <div class="detail-rating" id="detail-rating"></div>
      <div class="detail-seller" id="detail-seller"></div>
      <div class="detail-desc" id="detail-desc"></div>
    </div>
    <div class="detail-footer">
      <div class="qty-controls">
        <button class="qty-btn" onclick="changeQty(-1)">&minus;</button>
        <span class="qty-value" id="qty-value">1</span>
        <button class="qty-btn" onclick="changeQty(1)">+</button>
      </div>
      <button class="add-to-cart-btn" id="add-to-cart-btn" onclick="addToCart()"></button>
    </div>
  </div>
</div>

<!-- ===== MAP PICKER MODAL ===== -->
<div class="map-modal" id="map-modal">
