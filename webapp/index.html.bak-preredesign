  document.getElementById('cheque-card-value').textContent = result.payment_card || '—';
  document.getElementById('cheque-recipient-label').textContent = t.chequeRecipientLabel;
  document.getElementById('cheque-recipient-value').textContent = result.payment_recipient || '—';
  document.getElementById('cheque-copy-card').textContent = t.chequeCopyBtn;
  document.getElementById('cheque-hint').textContent = t.chequeHint;

  const pickBtn = document.getElementById('cheque-pick-btn');
  pickBtn.textContent = t.chequePickBtn;
  pickBtn.classList.remove('has-file');

  const submit = document.getElementById('cheque-submit-btn');
  submit.textContent = t.chequeSubmitBtn;
  submit.disabled = true;

  document.getElementById('cheque-pay-later-btn').textContent = t.chequePayLater;
