document.getElementById('cheque-copy-card').addEventListener('click', async () => {
  const card = document.getElementById('cheque-card-value').textContent;
  try {
    await navigator.clipboard.writeText(card);
    showToast(t.chequeCopiedToast);
  } catch (_) {
    // Fallback for older webviews — select the code element so the user
    // can copy with the system menu.
    const range = document.createRange();
    range.selectNodeContents(document.getElementById('cheque-card-value'));
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
});

function onChequeFileSelected(event) {
  const file = event.target.files && event.target.files[0];
  if (!file) return;
  if (file.size > 10 * 1024 * 1024) {
    showToast(t.chequeFileTooLarge, true);
    event.target.value = '';
    return;
  }
  chequeFile = file;

  const pickBtn = document.getElementById('cheque-pick-btn');
  pickBtn.textContent = t.chequePickedFile.replace('{name}', file.name);
  pickBtn.classList.add('has-file');

  const preview = document.getElementById('cheque-preview');
  preview.innerHTML = '';
  preview.style.display = 'block';
  if (file.type.startsWith('image/')) {
    const img = document.createElement('img');
    img.src = URL.createObjectURL(file);
    img.onload = () => URL.revokeObjectURL(img.src);
    preview.appendChild(img);
  } else {
    const row = document.createElement('div');
    row.className = 'doc-row';
    row.textContent = '📄 ' + file.name;
    preview.appendChild(row);
  }

  document.getElementById('cheque-submit-btn').disabled = false;
}

async function submitCheque() {
  if (!chequeFile) return;
  const submit = document.getElementById('cheque-submit-btn');
  submit.disabled = true;
  submit.textContent = t.chequeUploading;

  const fd = new FormData();
  fd.append('file', chequeFile, chequeFile.name);

  try {
    // Deferred-order flow: the server reads pending checkout from FSM state
    // (set by /api/checkout) and creates the order + attaches the cheque in
    // one shot. No order_id in the URL because the order doesn't exist yet.
    const res = await fetch('/api/checkout/cheque', {
      method: 'POST',
      headers: { 'Authorization': AUTH },  // no Content-Type — browser sets multipart boundary
      body: fd,
    });
    if (!res.ok) {
      let body = null;
      try { body = await res.json(); } catch (_) {}
      if (body && body.error === 'file_too_large') {
        showToast(t.chequeFileTooLarge, true);
      } else if (body && body.error === 'stock_gone') {
        // Stock ran out between checkout submission and cheque upload —
        // bounce them back to the cart so they can adjust quantities. Reuse
        // the same toast as the regular cart-out-of-stock path.
        showToast(t.errorStockGone || t.chequeUploadError, true);
        await loadCart();
        switchPage('cart');
      } else if (body && body.error === 'no_pending_checkout') {
        // FSM state lost (restart / expiry) — send them back to the cart
        // to restart checkout.
        showToast(t.chequeUploadError, true);
        switchPage('cart');
      } else if (res.status === 403) {
        showToast(t.errorSessionExpired, true);
      } else {
        showToast(t.chequeUploadError, true);
      }
      submit.disabled = false;
      submit.textContent = t.chequeSubmitBtn;
      return;
    }
    showToast(t.chequeReceivedToast);
    if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
    // Land them on My Orders so they can see the new pending order.
    switchPage('orders');
  } catch (e) {
    console.error('Cheque upload error:', e);
    showToast(t.chequeUploadError, true);
    submit.disabled = false;
    submit.textContent = t.chequeSubmitBtn;
  }
}

function closeMiniAppForChat() {
  // Buyer chose to pay via the bot chat instead. /api/checkout already
