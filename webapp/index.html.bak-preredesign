// ===== HELPERS =====
function formatPrice(price) {
  return Math.round(price).toLocaleString('ru-RU').replace(/,/g, ' ');
}

// Renders price block (with strikethrough original + red final + badge when discounted).
function priceHtml(p, suffix) {
  suffix = suffix === undefined ? ' UZS' : suffix;
  const d = p.discount_percent || 0;
  if (d > 0 && p.original_price && p.original_price !== p.price) {
    return '<span class="price-old">' + formatPrice(p.original_price) + '</span>' +
           '<span class="price-new">' + formatPrice(p.price) + suffix + '</span>' +
           '<span class="discount-badge">-' + d + '%</span>';
  }
  return formatPrice(p.price) + suffix;
}

function discountCornerHtml(p) {
  const d = p.discount_percent || 0;
  return d > 0 ? '<div class="discount-corner">-' + d + '%</div>' : '';
}

// Compact "you save N" line for cards/lists. Empty when not discounted.
function savingHtml(p) {
  const d = p.discount_percent || 0;
  if (d > 0 && p.original_price && p.original_price > p.price) {
    const saved = Math.round(p.original_price - p.price);
    return '<div class="card-saving">' + t.youSave.replace('{amount}', formatPrice(saved)) + '</div>';
  }
  return '';
}

// Short DD.MM for the discount-deadline ribbon on cards.
function shortDate(iso) {
  if (!iso) return '';
  const isoUtc = iso.endsWith('Z') || /[+-]\d\d:?\d\d$/.test(iso) ? iso : iso + 'Z';
  const d = new Date(isoUtc);
  if (isNaN(d.getTime())) return '';
  const pad = (n) => String(n).padStart(2, '0');
  return pad(d.getDate()) + '.' + pad(d.getMonth() + 1);
}

// Discount-deadline ribbon (top-left of the image) — only when the discount
// has an expiry. Echoes the reference design's date banner without obscuring
// the product like a price circle would.
function discountUntilCornerHtml(p) {
  const d = p.discount_percent || 0;
  if (d > 0 && p.discount_until) {
    const s = shortDate(p.discount_until);
    if (s) return '<div class="disc-until-corner">⏳ ' + s + '</div>';
  }
  return '';
}

// Tashkent bounding box — must match cart.py TASHKENT_BOUNDS.
// ~5 km buffer around the city proper so the fringes / near-suburbs still
// count as in-Tashkent (self-delivery + cash allowed).
function isInTashkent(lat, lng) {
  return lat >= 41.10 && lat <= 41.50 && lng >= 69.04 && lng <= 69.51;
}

// Render delivery options for the checkout page based on whether the user is in Tashkent.
// Tashkent: self-delivery vs Yandex Taxi.  Outside: courier services (Yandex Market, BTS, EMU).
function renderDeliveryOptions(inTashkent) {
  const opts = inTashkent
    ? [['self', 'delSelf'], ['yandex_taxi', 'delYandexTaxi']]
    : [['yandex_market', 'delYandexMarket'], ['bts', 'delBts'], ['emu', 'delEmu']];
  const container = document.getElementById('delivery-options');
  container.innerHTML = opts.map(([code, key], i) =>
    '<button type="button" class="del-opt' + (i === 0 ? ' active' : '') +
    '" data-method="' + code + '">' + t[key] + '</button>'
  ).join('');
  document.getElementById('delivery-group').style.display = '';
  document.getElementById('lbl-delivery').textContent = t.lblDelivery;
  // Wire up click toggles (scoped to delivery options only)
  container.querySelectorAll('.del-opt').forEach(btn => {
    btn.onclick = () => {
      container.querySelectorAll('.del-opt').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      applyPaymentRestrictions();
    };
  });
  applyPaymentRestrictions();
}

// Cash is only valid when WE deliver (Tashkent + self). Any third-party
// courier — Yandex Taxi, Yandex Market, BTS, EMU — won't take cash on our
// behalf, so the button is disabled and the active payment is forced to
// online when one of those methods is picked.
function applyPaymentRestrictions() {
  const method = document.querySelector('.del-opt.active')?.dataset.method;
  const cashBtn = document.getElementById('pay-cash');
  const onlineBtn = document.getElementById('pay-online');
  if (!cashBtn || !onlineBtn) return;
  const cashForbidden = method && method !== 'self';
  cashBtn.disabled = cashForbidden;
  cashBtn.style.opacity = cashForbidden ? '0.4' : '';
  cashBtn.style.cursor = cashForbidden ? 'not-allowed' : '';
  if (cashForbidden && cashBtn.classList.contains('active')) {
    cashBtn.classList.remove('active');
    onlineBtn.classList.add('active');
  }
}

// Format an ISO timestamp from the API (server stored as naive UTC) as DD.MM.YYYY HH:mm
function formatDiscountDate(iso) {
  // Treat the server's naive UTC string as UTC explicitly
  const isoUtc = iso.endsWith('Z') || /[+-]\d\d:?\d\d$/.test(iso) ? iso : iso + 'Z';
  const d = new Date(isoUtc);
  if (isNaN(d.getTime())) return iso;
  const pad = (n) => String(n).padStart(2, '0');
  return pad(d.getDate()) + '.' + pad(d.getMonth() + 1) + '.' + d.getFullYear() +
         ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}

function escapeHtml(str) {
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

function showToast(msg, isError = false) {
  let toast = document.getElementById('app-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'app-toast';
    toast.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);padding:10px 20px;border-radius:12px;font-size:14px;z-index:9999;opacity:0;transition:opacity 0.3s;pointer-events:none;max-width:80%;text-align:center';
    document.body.appendChild(toast);
  }
  toast.textContent = msg;
  toast.style.background = isError ? 'rgba(220,50,50,0.9)' : 'rgba(0,0,0,0.8)';
  toast.style.color = '#fff';
  toast.style.opacity = '1';
  clearTimeout(toast._timer);
  toast._timer = setTimeout(() => { toast.style.opacity = '0'; }, 2500);
}
