// ===== ORDERS PAGE =====
function deliveryLabel(method) {
  const map = {
    self: t.delSelfLabel,
    yandex_taxi: t.delYandexTaxiLabel,
    yandex_market: t.delYandexMarketLabel,
    bts: t.delBtsLabel,
    emu: t.delEmuLabel,
  };
  return method && map[method] ? map[method] : '—';
}

function paymentLabel(method) {
  if (method === 'cash') return t.payCashLabel;
  if (method === 'online') return t.payOnlineLabel;
  return '—';
}

function statusLabel(status) {
  const map = {
    pending: t.orderStatusPending,
    confirmed: t.orderStatusConfirmed,
    shipped: t.orderStatusShipped,
    delivered: t.orderStatusDelivered,
    cancelled: t.orderStatusCancelled,
  };
  return map[status] || status;
}

// Reuses the same UTC-naive ISO format the discount expiry uses
function formatOrderDate(iso) {
  if (!iso) return '';
  const isoUtc = iso.endsWith('Z') || /[+-]\d\d:?\d\d$/.test(iso) ? iso : iso + 'Z';
  const d = new Date(isoUtc);
  if (isNaN(d.getTime())) return iso;
  const pad = (n) => String(n).padStart(2, '0');
  return pad(d.getDate()) + '.' + pad(d.getMonth() + 1) + ' ' +
         pad(d.getHours()) + ':' + pad(d.getMinutes());
}

async function loadOrdersPage() {
  document.getElementById('orders-title').textContent = t.ordersTitle;
  document.getElementById('orders-empty-text').textContent = t.ordersEmpty;

  const list = document.getElementById('orders-list');
  const empty = document.getElementById('orders-empty');
  list.innerHTML = '';
  empty.style.display = 'none';

  let orders;
  try {
    orders = await api('/api/orders');
  } catch(e) {
    console.error('Load orders error:', e);
    if (e && e.status === 403) {
      showToast(t.errorSessionExpired, true);
    } else {
      showToast(t.errorLoad, true);
    }
    return;
  }

  if (!orders.length) {
    empty.style.display = 'block';
    return;
  }

  orders.forEach(o => {
    const itemsHtml = (o.items || []).slice(0, 5).map(it => {
      const qty = it.quantity % 1 === 0 ? it.quantity : Number(it.quantity).toFixed(1);
      return '<div>• ' + escapeHtml(it.name || '—') + ' &mdash; ' +
             qty + ' ' + escapeHtml(it.unit || '') + '</div>';
    }).join('');
    const moreItems = (o.items || []).length > 5
      ? '<div style="opacity:0.7">+' + ((o.items || []).length - 5) + '…</div>'
      : '';

    const timeline = [];
    if (o.created_at)   timeline.push('<span>' + t.orderCreatedAt   + ': ' + formatOrderDate(o.created_at)   + '</span>');
    if (o.confirmed_at) timeline.push('<span>' + t.orderConfirmedAt + ': ' + formatOrderDate(o.confirmed_at) + '</span>');
    if (o.shipped_at)   timeline.push('<span>' + t.orderShippedAt   + ': ' + formatOrderDate(o.shipped_at)   + '</span>');
    if (o.delivered_at) timeline.push('<span>' + t.orderDeliveredAt + ': ' + formatOrderDate(o.delivered_at) + '</span>');

    const cancellable = (o.status === 'pending' || o.status === 'confirmed');
    const cancelBtn = cancellable
      ? '<button class="order-cancel-btn" data-order-id="' + o.id + '">' + t.btnCancelOrder + '</button>'
      : '';

    const card = document.createElement('div');
    card.className = 'order-card';
    card.innerHTML =
      '<div class="order-card-head">' +
        '<div><span class="order-id">#' + o.id + '</span>' +
          '<span class="order-status ' + o.status + '">' + statusLabel(o.status) + '</span></div>' +
        '<div class="order-total">' + formatPrice(o.total) + ' UZS</div>' +
      '</div>' +
      '<div class="order-meta">' + t.orderDelivery + ': ' + deliveryLabel(o.delivery_method) +
        ' &nbsp;·&nbsp; ' + t.orderPayment + ': ' + paymentLabel(o.payment_method) + '</div>' +
      '<div class="order-items">' + itemsHtml + moreItems + '</div>' +
      (timeline.length ? '<div class="order-timeline">' + timeline.join('') + '</div>' : '') +
      cancelBtn;
    list.appendChild(card);
  });

  // Wire up cancel buttons (Telegram WebApp confirm + POST + reload)
  document.querySelectorAll('.order-cancel-btn').forEach(btn => {
    btn.onclick = async () => {
      const id = parseInt(btn.dataset.orderId, 10);
      const ok = await new Promise(resolve => {
        const msg = t.confirmCancelOrder.replace('{id}', id);
        if (tg.showConfirm) {
          tg.showConfirm(msg, resolve);
        } else {
          resolve(window.confirm(msg));
        }
      });
      if (!ok) return;

      btn.disabled = true;
      try {
        await api('/api/orders/' + id + '/cancel', { method: 'POST' });
        showToast(t.orderCancelled);
        await loadOrdersPage();  // refresh — status pill flips to "cancelled"
      } catch(e) {
        console.error('Cancel error:', e);
        if (e && e.body && e.body.error === 'cannot_cancel') {
          showToast(t.cancelTooLate, true);
        } else {
          showToast(t.errorCancel, true);
        }
        btn.disabled = false;
      }
    };
  });
}

